# Local settings, read by docker compose and the scripts in this directory.
# Copy to .env (not under version control) and adjust:  cp .env.example .env
# Syntax: plain KEY=value lines (the file is also sourced by sh), quote values
# containing spaces with single quotes. Passwords do not go here but into
# secrets/, see README.md (Installation).

# the location where data files are kept on local (host) disk
SOLAR_HEAT_DIR=/Users/axel/Documents/Wohnung/sophienallee/heizungsgruppe/SC514
# host name or ip address of the WLAN_SD card in the solar appliance
# (empty: update-files.sh does nothing)
WLAN_SD_IP=192.168.80.42
# public domain name of the dashboard: its DNS A/AAAA record must point to
# this host and ports 80 and 443 must be reachable from the internet, so that
# caddy can obtain a certificate from Let's Encrypt
DASHBOARD_DOMAIN=solar.example.com
# optional read-only grafana user (role "Viewer"), e.g. for kiosk mode, with
# the password from secrets/grafana_viewer_password; created/updated on every
# ./docker-up.sh. Leave empty to skip (secrets/grafana_viewer_password must
# exist anyway, any content).
GRAFANA_VIEWER_USER=viewer
