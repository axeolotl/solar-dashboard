# Reverse proxy with automatic HTTPS (Let's Encrypt / ZeroSSL).
# Certificates are obtained and renewed automatically; HTTP is redirected
# to HTTPS. DASHBOARD_DOMAIN comes from config.sh.
{$DASHBOARD_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy grafana:3000
}
